# Dependencies and builds
node_modules/
.next/
dist/
out/
*.tsbuildinfo
next-env.d.ts

# Tests
coverage/
playwright-report/
test-results/
# A saved sign-in session: a real token, never committed
apps/web/e2e/.auth/

# Environment files: never commit secrets
.env*
!.env.example

# Tooling
.vercel/
supabase/.temp/
supabase/.branches/

# Impeccable, installed by `npx impeccable install`. Reinstallable, and the
# skill carries a 14MB platform-specific binary that doesn't belong in git.
.claude/skills/impeccable/
.claude/agents/impeccable-*.md
# Machine-local Claude Code settings; Impeccable's hooks live here
.claude/settings.local.json
# The design hook's cache. Rewritten on every UI edit, so it is neither worth
# committing nor worth holding to Prettier's formatting.
.impeccable/hook.cache.json
**/.impeccable/hook.cache.json

# OS
.DS_Store

# Git worktrees for parallel sessions; the parent directory is not writable here
.worktrees/
