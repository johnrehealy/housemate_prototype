{
  "env": {
    "NEXT_TELEMETRY_DISABLED": "1"
  },
  "autoCompactEnabled": true,
  "autoCompactWindow": 400000,
  "hooks": {
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "printf '{\"systemMessage\":\"This session was just compacted. Read tasks/handoff.md before continuing, then pick up from its What next section.\"}'"
          }
        ]
      }
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "filesystem": {
      "allowWrite": [
        "~/Library/pnpm",
        "~/Library/Caches/pnpm",
        "~/.cache/node/corepack",
        "~/.npm"
      ],
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.netrc",
        "~/.config/gh",
        "~/.docker/config.json"
      ]
    },
    "network": {
      "allowedDomains": [
        "registry.npmjs.org",
        "github.com",
        "*.githubusercontent.com",
        "fonts.googleapis.com",
        "fonts.gstatic.com",
        "localhost",
        "127.0.0.1"
      ],
      "allowLocalBinding": true
    }
  }
}
