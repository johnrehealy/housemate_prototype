# Copy to .env.local for local development. Never commit real values.

# Which environment this process runs in: local | staging | production
APP_ENV=local

# Public URL of the web app. Twilio signs requests against it.
PUBLIC_BASE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Same URL, read by server-side code (actions, worker)
SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Direct Postgres connection used by application actions and the worker
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Texting: simulator | twilio
SMS_PROVIDER=simulator
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_PHONE_NUMBER=

# Temporary acknowledgment reply until the agent exists (off in production)
ACK_REPLY_ENABLED=true

# Comma-separated E.164 numbers that receive team alerts
TEAM_ALERT_PHONES=

# The Apps Script web app (scripts/waitlist-alerts): waitlist alerts to the
# owner, and Housemate's emails (let-in links and sign-in codes, D-072, D-073).
# Production only; leave both blank everywhere else, which turns them off.
WAITLIST_ALERT_URL=
WAITLIST_ALERT_SECRET=

# Supabase Auth's Send Email hook, which hands sign-in codes to
# /api/auth/send-email (D-073). Production only; locally the hook is off and
# Mailpit (http://127.0.0.1:54324) catches the codes.
SEND_EMAIL_HOOK_SECRET=

# Get started's address search (D-068): google, fake (generated addresses,
# local only) or off (the address is typed). Local development and tests use
# fake. GOOGLE_MAPS_API_KEY is server-only, for Places API (New) and the Maps
# Static API, and needed only with google.
ADDRESS_LOOKUP=fake
GOOGLE_MAPS_API_KEY=
